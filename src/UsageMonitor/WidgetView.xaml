<UserControl x:Class="UsageMonitor.WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="4" ToolTip="{Binding HoverText}">
    <Border x:Name="MenuSurface" CornerRadius="12" Background="{DynamicResource CardBrush}" Opacity="0.96">
      <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="7" ShadowDepth="2" Opacity="0.12" /></Border.Effect>
    </Border>
    <Border x:Name="MenuFrame" CornerRadius="12" BorderThickness="1" Padding="10,8" Background="Transparent">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
          <Style.Triggers><DataTrigger Binding="{Binding Stale}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers>
        </Style>
      </Border.Style>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="미리보기" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,3"
                     Visibility="{Binding Preview, Converter={StaticResource VisibleWhenTrue}}" />
          <TextBlock Text="표시할 서비스 없음" FontSize="9" Height="20" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryBrush}" TextWrapping="NoWrap"
                     ToolTip="마우스 오른쪽 버튼 → 설정에서 표시할 서비스를 선택해주세요."
                     Visibility="{Binding NoProvidersVisible, Converter={StaticResource VisibleWhenTrue}}" />
          <ItemsControl ItemsSource="{Binding Providers}" AlternationCount="2147483647">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Style.Triggers>
                  <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter Property="Margin" Value="0" /></Trigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ToolTip="{Binding HoverText}">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid Height="20" VerticalAlignment="Top">
                    <TextBlock Text="{Binding ProviderName}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                  </Grid>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Metrics}" Visibility="{Binding HasMetrics, Converter={StaticResource VisibleWhenTrue}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="20">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <ProgressBar Grid.Column="1" Value="{Binding Remaining, Mode=OneWay}" Maximum="100" Height="4" Margin="6,0"
                                       Foreground="{Binding Accent}" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                            <AutomationProperties.Name>
                              <MultiBinding StringFormat="{}{0} · {1}"><Binding Path="ProviderName" /><Binding Path="Label" /></MultiBinding>
                            </AutomationProperties.Name>
                            <ProgressBar.Template>
                              <ControlTemplate TargetType="ProgressBar">
                                <Grid x:Name="PART_Track"><Border CornerRadius="2" Background="{TemplateBinding Background}" /><Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" /></Grid>
                              </ControlTemplate>
                            </ProgressBar.Template>
                          </ProgressBar>
                          <TextBlock Grid.Column="2" Text="{Binding Percentage, Mode=OneWay}" FontSize="11.5" FontWeight="Medium"
                                     Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Grid.Column="1" Text="{Binding EmptyTitle}" FontSize="9" Height="20" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding EmptyVisible, Converter={StaticResource VisibleWhenTrue}}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ResetSummary}" FontSize="8.5" Margin="0,1,0,2"
                             Foreground="{DynamicResource SecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding ResetSummary}" AutomationProperties.Name="초기화까지 남은 시간"
                             Visibility="{Binding ResetCountdownVisible, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid x:Name="ResetNoticeRow" Height="0" Opacity="0" Visibility="Collapsed" ClipToBounds="True">
            <Grid.RenderTransform><TranslateTransform x:Name="ResetNoticeTranslation" Y="-4" /></Grid.RenderTransform>
            <Button x:Name="ResetNoticeButton" Height="20" Padding="0" BorderThickness="0" HorizontalContentAlignment="Left"
                    Visibility="{Binding ResetNoticeVisible, Converter={StaticResource VisibleWhenTrue}}"
                    Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding ResetNoticeToolTip}"
                    AutomationProperties.Name="Codex 리셋 공지" Click="ResetNotice_Click">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="15" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Width="11" Height="11" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Canvas Width="24" Height="24">
                    <Path Data="M 5,17 L 7,14 L 7,9 A 5,5 0 0 1 17,9 L 17,14 L 19,17 Z M 10,20 A 2,2 0 0 0 14,20 M 12,2 L 12,4"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding ResetNoticeText}" FontSize="9" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
