<UserControl x:Class="UsageMonitor.WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:UsageMonitor.Layout"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border Margin="4" CornerRadius="12" Background="{DynamicResource CardBrush}"
          BorderThickness="1" Padding="10,6" ToolTip="{Binding HoverText}">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Style.Triggers><DataTrigger Binding="{Binding Stale}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers>
      </Style>
    </Border.Style>
    <Border.Effect><DropShadowEffect Color="#14271B" BlurRadius="7" ShadowDepth="2" Opacity="0.15" /></Border.Effect>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="미리보기" FontSize="8" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,3"
                   Visibility="{Binding Preview, Converter={StaticResource VisibleWhenTrue}}" />
        <layout:UsageLayoutCanvas x:Name="CustomLayoutCanvas"
                                  Visibility="{Binding CustomLayoutVisible, Converter={StaticResource VisibleWhenTrue}}" />
        <ItemsControl ItemsSource="{Binding Providers}" Visibility="{Binding AutomaticLayoutVisible, Converter={StaticResource VisibleWhenTrue}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding HoverText}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Height="18" VerticalAlignment="Top">
                  <TextBlock Text="{Binding ProviderLabel}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                </Grid>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Metrics}" Visibility="{Binding HasMetrics, Converter={StaticResource VisibleWhenTrue}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="16" Margin="0,1" AutomationProperties.Name="{Binding Label}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                                   FontSize="10" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Value="{Binding Remaining, Mode=OneWay}" Maximum="100" Height="4" Margin="6,0"
                                     Foreground="{Binding Accent}" Background="{DynamicResource TrackBrush}" AutomationProperties.Name="남은 사용량" VerticalAlignment="Center">
                          <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                              <Grid x:Name="PART_Track"><Border CornerRadius="2" Background="{TemplateBinding Background}" /><Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" /></Grid>
                            </ControlTemplate>
                          </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock Grid.Column="2" Text="{Binding Percentage, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="1" Text="{Binding EmptyTitle}" FontSize="9" Height="18" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding EmptyVisible, Converter={StaticResource VisibleWhenTrue}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
